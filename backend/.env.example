# TU Chemnitz Badminton Backend Environment Configuration

# Server Port (Default: 5000)
PORT=5000

# CORS Origins (Comma-separated list or * for all)
ALLOWED_ORIGINS=https://gandupradeep2026.github.io,https://tucbadminton.github.io,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Master Admin Emergency Recovery Key
# Can be used in ForgotPassword modal if email is unreachable
ADMIN_MASTER_RECOVERY_KEY=TUC-MASTER-ADMIN-KEY-2026

# Optional SMTP Configuration for Nodemailer (e.g. Gmail App Password)
# SMTP_HOST=smtp.gmail.com
