# TU Chemnitz Badminton Backend Environment Configuration

# Server Port (Default: 5000)
PORT=5000

# CORS Origins (Comma-separated list or * for all)
ALLOWED_ORIGINS=https://gandupradeep2026.github.io

# Admin password for a fresh database (otherwise a random one is printed to the log once)
# ADMIN_INITIAL_PASSWORD=

# Optional emergency recovery key for the admin password reset, at least 24 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ADMIN_MASTER_RECOVERY_KEY=

# Optional SMTP Configuration for Nodemailer (e.g. Gmail App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=gandupradeep2026@gmail.com
# SMTP_PASS=your-app-password-here
